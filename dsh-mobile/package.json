{
  "name": "dsh-mobile",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "description": "DSH Web 任务通知：浏览器通知（需 HTTPS）与宿主端多通道推送（飞书/钉钉/企业微信/Telegram/ntfy/Server酱/Webhook），点击直达会话。布局交给 dsh 0.2.2 核心。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "check": "timeout 60 node test/client-harness.mjs",
    "test": "timeout 300 node --test --test-timeout=300000 test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "files": [
    "index.js",
    "client.js",
    "client.*.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
