{
  "name": "dsh-restart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "dsh web 受控重启：独立执行器、阶段化进度、失败现场与运行状态",
  "main": "lib/index.js",
  "license": "MIT",
  "files": [
    "lib/**",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2"
  }
}
